# SQLite file for events / couriers / mandates / verdicts / parcels.
VIGIL_DB_PATH=./data/db/vigil.db

# Append-only nonce ledger. Deliberately a file, not a DB table:
# the append-only + hash-chained file IS the tamper-evidence argument.
VIGIL_LEDGER_PATH=./data/ledger/nonce-ledger.jsonl

# LLM keys. The system must produce identical verdicts with all of these unset.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Operator co-signing keys (Ed25519, base64 DER).
# DEMO ONLY — see CLAUDE.md Known Limitations. Production needs an HSM or a
# managed KMS: this key is what makes operator approval constitutive.
# Generate with: node -e "const{generateKeyPairSync}=require('node:crypto');const{publicKey,privateKey}=generateKeyPairSync('ed25519');console.log('pub',publicKey.export({format:'der',type:'spki'}).toString('base64'));console.log('priv',privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
VIGIL_OPERATOR_ID=OP-01
VIGIL_OPERATOR_PUBLIC_KEY=
VIGIL_OPERATOR_PRIVATE_KEY=

# LLM providers. The agent runs, and produces identical verdicts, with all of
# these unset — see CLAUDE.md rule 1. Only the operator's explanation degrades.
GEMINI_MODEL=gemini-3.5-flash-lite
# Narrow JSON selection/explanation tasks do not need the model's longer reasoning path.
GEMINI_REASONING_EFFORT=minimal
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional local provider for the offline demo. This is the native Ollama server
# root; the provider calls /api/tags and /api/chat itself.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
