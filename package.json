{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run lib/llm/integration.test.ts lib/llm/multi-provider.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='lib/engine/**' --coverage.include='lib/pattern/**' --coverage.include='lib/gate/**' --coverage.exclude='**/fixtures.ts' --coverage.exclude='**/index.ts' --coverage.exclude='**/*.test.ts'",
    "experiments": "node --env-file-if-exists=.env --import tsx scripts/experiments/run-all.ts",
    "experiment:e4": "node --env-file-if-exists=.env --import tsx scripts/experiments/e4-llm-instability.ts",
    "experiment:e4a": "node --env-file-if-exists=.env --import tsx scripts/experiments/e4a-cross-vendor.ts",
    "experiment:e4c": "node --env-file-if-exists=.env --import tsx scripts/experiments/e4c-adversarial-robustness.ts",
    "experiment:e5": "node --env-file-if-exists=.env --import tsx scripts/experiments/e5-citation-hallucination.ts",
    "experiment:e5:providers": "node --env-file-if-exists=.env --import tsx scripts/experiments/e5-cross-provider-enforcement.ts",
    "llm:validate": "node --env-file-if-exists=.env --import tsx scripts/experiments/provider-live-validation.ts",
    "qa:capture": "node scripts/qa/capture-console.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@turf/turf": "^7.4.0",
    "@types/seedrandom": "^3.0.8",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "seedrandom": "^3.0.5",
    "shadcn": "^4.21.0",
    "simple-statistics": "^7.12.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
